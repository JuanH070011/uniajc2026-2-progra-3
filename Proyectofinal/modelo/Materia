package modelo;

import estructuras.Cola;
import estructuras.ListaEnlazada;

public class Materia {

    private String codigo;

    private String nombre;

    private int cupos;

    private int creditos;

    private ListaEnlazada<String>
            prerequisitos;

    private ListaEnlazada<Estudiante>
            inscritos;

    private Cola<Estudiante>
            colaEspera;

    public Materia(String codigo,
                   String nombre,
                   int cupos,
                   int creditos) {

        this.codigo = codigo;
        this.nombre = nombre;
        this.cupos = cupos;
        this.creditos = creditos;

        prerequisitos =
                new ListaEnlazada<>();

        inscritos =
                new ListaEnlazada<>();

        colaEspera =
                new Cola<>();
    }

    public String getCodigo() {
        return codigo;
    }

    public String getNombre() {
        return nombre;
    }

    public int getCupos() {
        return cupos;
    }

    public Cola<Estudiante>
    getColaEspera() {

        return colaEspera;
    }
}