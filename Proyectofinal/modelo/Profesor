package modelo;

public class Profesor extends Persona {

    private String especialidad;

    public Profesor(String id,
                    String nombre,
                    String email,
                    String especialidad) {

        super(id,nombre,email);

        this.especialidad =
                especialidad;
    }

    @Override
    public void mostrarInformacion() {

        System.out.println(nombre);
        System.out.println(especialidad);
    }
}