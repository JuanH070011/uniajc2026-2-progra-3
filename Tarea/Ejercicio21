import java.util.Scanner;

public class Ejercicio21 {
    public static void main(String[] args) {
        Scanner teclado = new Scanner(System.in);

        // Leer dimensiones de la matriz
        System.out.print("Ingrese el número de filas: ");
        int filas = teclado.nextInt();
        System.out.print("Ingrese el número de columnas: ");
        int columnas = teclado.nextInt();

        int[][] matriz = new int[filas][columnas];

        // Ingresar los elementos de la matriz
        System.out.println("Ingrese los elementos de la matriz:");
        for(int i=0; i<filas; i++){
            for(int j=0; j<columnas; j++){
                matriz[i][j] = teclado.nextInt();
            }
        }

        // Crear vector B con la suma de pares por fila
        int[] B = new int[filas];
        for(int i=0; i<filas; i++){
            int sumaPares = 0;
            for(int j=0; j<columnas; j++){
                if(matriz[i][j] % 2 == 0){ // Verifica si es par
                    sumaPares += matriz[i][j];
                }
            }
            B[i] = sumaPares;
        }

        // Mostrar el vector B
        System.out.println("\nVector B (suma de pares por fila):");
        for(int i=0; i<filas; i++){
            System.out.println("Fila " + (i+1) + ": " + B[i]);
        }

        teclado.close();
    }
}
