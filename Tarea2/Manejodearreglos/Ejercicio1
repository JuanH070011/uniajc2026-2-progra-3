import java.util.Scanner;

public class Ejercicio1 {
    public static void main(String[] args) {
        Scanner teclado = new Scanner(System.in);
        int[] A = new int[10];

        System.out.println("Ingrese 10 números:");

        for(int i = 0; i < 10; i++) {
            A[i] = teclado.nextInt();
        }

        int mayor = A[0];

        for(int i = 1; i < 10; i++) {
            if(A[i] > mayor) {
                mayor = A[i];
            }
        }

        System.out.println("El número mayor es: " + mayor);

        teclado.close();
    }
}