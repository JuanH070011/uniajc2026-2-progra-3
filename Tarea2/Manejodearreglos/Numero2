import java.util.Scanner;

public class Ejercicio2 {
    public static void main(String[] args) {
        Scanner teclado = new Scanner(System.in);
        int[] A = new int[10];

        System.out.println("Ingrese 10 números:");

        for(int i = 0; i < 10; i++) {
            A[i] = teclado.nextInt();
        }

        int menor = A[0];

        for(int i = 1; i < 10; i++) {
            if(A[i] < menor) {
                menor = A[i];
            }
        }

        System.out.println("El número menor es: " + menor);

        teclado.close();
    }
}